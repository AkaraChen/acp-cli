+    pub(crate) fn open_acpc_options(&mut self) {
+        let mut items = Vec::new();
+        if let Some(modes) = &self.acpc.modes {
+            let current = modes
+                .available
+                .iter()
+                .find(|mode| mode.id == modes.current_mode_id)
+                .map_or(modes.current_mode_id.as_str(), |mode| mode.name.as_str());
+            items.push(SelectionItem {
+                name: "Mode".to_string(),
+                description: Some(current.to_string()),
+                actions: vec![send(AcpcAppEvent::OpenModes)],
+                dismiss_on_select: true,
+                ..Default::default()
+            });
+        }
+        for option in &self.acpc.options {
+            match &option.kind {
+                AcpcSessionConfigKind::Select {
+                    current_value,
+                    options,
+                } => {
+                    let current = options
+                        .iter()
+                        .find(|value| &value.value == current_value)
+                        .map_or(current_value.as_str(), |value| value.name.as_str());
+                    items.push(SelectionItem {
+                        name: option.name.clone(),
+                        description: Some(current.to_string()),
+                        selected_description: option.description.clone(),
+                        actions: vec![send(AcpcAppEvent::OpenOptionValues {
+                            config_id: option.id.clone(),
+                        })],
+                        dismiss_on_select: true,
+                        ..Default::default()
+                    });
+                }
+                AcpcSessionConfigKind::Boolean { current_value } => {
+                    items.push(SelectionItem {
+                        name: option.name.clone(),
+                        description: Some(if *current_value { "on" } else { "off" }.to_string()),
+                        selected_description: option.description.clone(),
+                        actions: vec![send(AcpcAppEvent::SetConfigOption {
+                            config_id: option.id.clone(),
+                            value: AcpcSessionConfigInput::Boolean(!current_value),
+                        })],
+                        dismiss_on_select: true,
+                        ..Default::default()
+                    });
+                }
+            }
+        }
+        if items.is_empty() {
+            self.add_info_message("The agent has no session options.".to_string(), None);
+            return;
+        }
+        self.bottom_pane.show_selection_view(SelectionViewParams {
+            title: Some("Session options".to_string()),
+            subtitle: Some("Settings the agent offers for this session.".to_string()),
+            footer_hint: Some(standard_popup_hint_line()),
+            items,
+            ..SelectionViewParams::picker()
+        });
+        self.request_redraw();
+    }
