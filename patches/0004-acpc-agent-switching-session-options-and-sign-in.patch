+    /// Shift+Tab: move to the agent's next mode.
+    pub(super) fn acpc_cycle_mode(&mut self) {
+        if let Some(option) = self.acpc_mode_option() {
+            let AcpcSessionConfigKind::Select {
+                current_value,
+                options,
+            } = &option.kind
+            else {
+                return;
+            };
+            let Some(index) = options.iter().position(|value| &value.value == current_value)
+            else {
+                return;
+            };
+            let next = &options[(index + 1) % options.len()];
+            let message = format!("{}: {}", option.name, next.name);
+            let event = AcpcAppEvent::SetConfigOption {
+                config_id: option.id.clone(),
+                value: AcpcSessionConfigInput::Value(next.value.clone()),
+            };
+            self.app_event_tx.send(AppEvent::Acpc(event));
+            self.add_info_message(message, None);
+            return;
+        }
+        let Some(modes) = &self.acpc.modes else {
+            return;
+        };
+        let Some(index) = modes
+            .available
+            .iter()
+            .position(|mode| mode.id == modes.current_mode_id)
+        else {
+            return;
+        };
+        let next = &modes.available[(index + 1) % modes.available.len()];
+        let message = format!("Mode: {}", next.name);
+        let event = AcpcAppEvent::SetMode {
+            mode_id: next.id.clone(),
+        };
+        self.app_event_tx.send(AppEvent::Acpc(event));
+        self.add_info_message(message, None);
+    }
