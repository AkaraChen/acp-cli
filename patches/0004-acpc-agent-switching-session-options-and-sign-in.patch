+//! acpc: app-level handling of ACP agent switching, session options and
+//! sign-in (see `crate::acpc`).
+
+use super::*;
+use crate::acpc::AcpcAppEvent;
+use crate::app::app_server_requests::BufferedServerRequest;
+use crate::history_cell::UserHistoryCell;
+use codex_app_server_protocol::AcpcAgentSelectParams;
+use codex_app_server_protocol::AcpcAgentSelectResponse;
+use codex_app_server_protocol::AcpcModeSetParams;
+use codex_app_server_protocol::AcpcModeSetResponse;
+use codex_app_server_protocol::AcpcSessionConfigSetParams;
+use codex_app_server_protocol::AcpcSessionConfigSetResponse;
+use codex_app_server_protocol::AcpcTerminalRunParams;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ServerRequest;
+
+impl App {
+    /// Serve app-scoped acpc server requests. Returns false for others.
+    pub(super) fn handle_acpc_server_request(
+        &mut self,
+        buffered_request: &BufferedServerRequest,
+    ) -> bool {
+        match &buffered_request.request {
+            ServerRequest::AcpcAuthSelect { params, .. } => {
+                let key = crate::acpc::store_reply(buffered_request.reply.clone());
+                self.chat_widget.open_acpc_auth_picker(params, key);
+                true
+            }
+            ServerRequest::AcpcTerminalRun { params, .. } => {
+                // Needs the terminal, which only `handle_event` can lend.
+                self.app_event_tx
+                    .send(AppEvent::Acpc(AcpcAppEvent::RunTerminal {
+                        params: params.clone(),
+                        reply: buffered_request.reply.clone(),
+                    }));
+                true
+            }
+            _ => false,
+        }
+    }
+
+    pub(super) async fn handle_acpc_event(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        event: AcpcAppEvent,
+    ) -> Result<AppRunControl> {
+        match event {
+            AcpcAppEvent::SelectAgent { slug } => {
+                let has_conversation = self
+                    .transcript_cells
+                    .iter()
+                    .any(|cell| cell.as_any().downcast_ref::<UserHistoryCell>().is_some());
+                if has_conversation && self.chat_widget.thread_id().is_some() {
+                    self.chat_widget.open_acpc_handoff_prompt(&slug);
+                } else {
+                    self.switch_acpc_agent(app_server, slug, /*bring*/ false);
+                }
+            }
+            AcpcAppEvent::SwitchAgent { slug, bring } => self.switch_acpc_agent(app_server, slug, bring),
+            AcpcAppEvent::SetConfigOption { config_id, value } => {
+                let Some(thread_id) = self.chat_widget.thread_id() else {
+                    return Ok(AppRunControl::Continue);
+                };
+                let request = ClientRequest::AcpcSessionConfigSet {
+                    request_id: app_server.next_request_id(),
+                    params: AcpcSessionConfigSetParams {
+                        thread_id: thread_id.to_string(),
+                        config_id,
+                        value,
+                    },
+                };
+                self.spawn_acpc_request::<AcpcSessionConfigSetResponse>(app_server, request);
+            }
+            AcpcAppEvent::SetMode { mode_id } => {
+                let Some(thread_id) = self.chat_widget.thread_id() else {
+                    return Ok(AppRunControl::Continue);
+                };
+                let request = ClientRequest::AcpcModeSet {
+                    request_id: app_server.next_request_id(),
+                    params: AcpcModeSetParams {
+                        thread_id: thread_id.to_string(),
+                        mode_id,
+                    },
+                };
+                self.spawn_acpc_request::<AcpcModeSetResponse>(app_server, request);
+            }
+            AcpcAppEvent::OpenOptionValues { config_id } => {
+                self.chat_widget.open_acpc_option_values(&config_id);
+            }
+            AcpcAppEvent::OpenModes => self.chat_widget.open_acpc_modes(),
+            AcpcAppEvent::AuthChosen { key, method_id } => {
+                if let Some(reply) = crate::acpc::take_reply(key) {
+                    tokio::spawn(async move {
+                        let result = serde_json::json!({ "methodId": method_id });
+                        if let Err(err) = reply.resolve(result).await {
+                            tracing::warn!("failed to answer acpc/auth/select: {err}");
+                        }
+                    });
+                }
+            }
+            AcpcAppEvent::RunTerminal { params, reply } => {
+                let exit_code = run_in_terminal(tui, &params).await;
+                tui.frame_requester().schedule_frame();
+                let response = match exit_code {
+                    Ok(exit_code) => reply.resolve(serde_json::json!({ "exitCode": exit_code })).await,
+                    Err(err) => {
+                        reply
+                            .reject(JSONRPCErrorError {
+                                code: -32603,
+                                data: None,
+                                message: format!("could not run {}: {err}", params.command),
+                            })
+                            .await
+                    }
+                };
+                if let Err(err) = response {
+                    tracing::warn!("failed to answer acpc/terminal/run: {err}");
+                }
+            }
+            AcpcAppEvent::Error(message) => self.chat_widget.add_error_message(message),
+        }
+        Ok(AppRunControl::Continue)
+    }
+
+    fn switch_acpc_agent(&self, app_server: &mut AppServerSession, slug: String, bring: bool) {
+        // Not awaited here: switching may need the user to sign in through
+        // acpc/auth/select and acpc/terminal/run, which this loop must stay
+        // free to serve.
+        let request = ClientRequest::AcpcAgentSelect {
+            request_id: app_server.next_request_id(),
+            params: AcpcAgentSelectParams { slug },
+        };
+        let handle = app_server.request_handle();
+        let tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            match handle.request_typed::<AcpcAgentSelectResponse>(request).await {
+                // The bridge forks onto the agent just selected.
+                Ok(_) if bring => tx.send(AppEvent::ForkCurrentSession { name: None }),
+                Ok(_) => tx.send(AppEvent::NewSession { name: None }),
+                Err(err) => tx.send(AppEvent::Acpc(AcpcAppEvent::Error(format!(
+                    "Could not switch agent: {err}"
+                )))),
+            }
+        });
+    }
+
+    fn spawn_acpc_request<T>(&self, app_server: &AppServerSession, request: ClientRequest)
+    where
+        T: serde::de::DeserializeOwned + Send + 'static,
+    {
+        let handle = app_server.request_handle();
+        let tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            if let Err(err) = handle.request_typed::<T>(request).await {
+                tx.send(AppEvent::Acpc(AcpcAppEvent::Error(format!(
+                    "The agent rejected the change: {err}"
+                ))));
+            }
+        });
+    }
+}
+
+/// Give the terminal to `params.command` until it exits (ACP terminal
+/// sign-in), then take it back.
+async fn run_in_terminal(tui: &mut tui::Tui, params: &AcpcTerminalRunParams) -> std::io::Result<Option<i32>> {
+    tui.with_restored(tui::TerminalHandoff::Restore, || async {
+        // Ctrl+C reaches the whole foreground group once raw mode is off;
+        // catch it before then so it can never kill acpc.
+        #[cfg(unix)]
+        let mut interrupts =
+            tokio::signal::unix::signal(tokio::signal::unix::SignalKind::interrupt())?;
+        // Ctrl+\ likewise; registering the handler is enough to catch it.
+        #[cfg(unix)]
+        let _quits = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::quit())?;
+        #[cfg(windows)]
+        let mut interrupts = tokio::signal::windows::ctrl_c()?;
+        crossterm::terminal::disable_raw_mode()?;
+        // Nothing is drawn during the handoff; tell the user what runs. The
+        // text comes from the agent, so it must not drive the terminal.
+        println!("\n{}", escape_controls(&params.title));
+        let command_line = format!("{} {}", params.command, params.args.join(" "));
+        println!("$ {}\n", escape_controls(&command_line));
+        if let Some(question) = &params.confirm {
+            println!("{}", escape_controls(question));
+            print!("Continue? [y/N] ");
+            std::io::Write::flush(&mut std::io::stdout())?;
+            let confirmed = tokio::task::spawn_blocking(read_confirmation)
+                .await
+                .map_err(std::io::Error::other)??;
+            println!("{}", if confirmed { "y" } else { "n" });
+            if !confirmed {
+                return Ok(None);
+            }
+        }
+        let mut command = tokio::process::Command::new(&params.command);
+        command.args(&params.args);
+        for (name, value) in &params.env {
+            match value {
+                Some(value) => command.env(name, value),
+                None => command.env_remove(name),
+            };
+        }
+        if let Some(cwd) = &params.cwd {
+            command.current_dir(cwd);
+        }
+        let mut child = command.spawn()?;
+        // The child handles Ctrl+C; acpc ignores it until the child exits.
+        let status = loop {
+            tokio::select! {
+                status = child.wait() => break status?,
+                _ = interrupts.recv() => {}
+            }
+        };
+        Ok(status.code())
+    })
+    .await
+}
+
+/// Read the y/N answer as a single key in raw mode, so Ctrl+C is a key
+/// rather than a signal. Only `y` confirms; anything else (Enter, Esc, `n`,
+/// Ctrl+C, Ctrl+D) declines.
+fn read_confirmation() -> std::io::Result<bool> {
+    use crossterm::event::Event;
+    use crossterm::event::KeyCode;
+    use crossterm::event::KeyEventKind;
+    use crossterm::event::KeyModifiers;
+
+    crossterm::terminal::enable_raw_mode()?;
+    let answer = (|| {
+        // Keys typed before the prompt must not answer it.
+        crate::tui::discard_pending_terminal_input()?;
+        loop {
+            if let Event::Key(key) = crossterm::event::read()?
+                && key.kind != KeyEventKind::Release
+            {
+                return Ok(matches!(key.code, KeyCode::Char('y' | 'Y'))
+                    && !key
+                        .modifiers
+                        .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT));
+            }
+        }
+    })();
+    crossterm::terminal::disable_raw_mode()?;
+    answer
+}
+
+/// Agent-supplied text with control characters (other than newlines)
+/// escaped, so it cannot move the cursor or erase what is shown.
+fn escape_controls(text: &str) -> String {
+    text.chars()
+        .map(|c| {
+            if c.is_control() && c != '\n' {
+                c.escape_default().to_string()
+            } else {
+                c.to_string()
+            }
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::escape_controls;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn escape_controls_keeps_newlines_and_escapes_the_rest() {
+        assert_eq!(
+            escape_controls("  PATH=/tmp/evil:\u{1b}[2K\r  PATH=/usr/bin\n  HOME=\u{9b}x\t"),
+            "  PATH=/tmp/evil:\\u{1b}[2K\\r  PATH=/usr/bin\n  HOME=\\u{9b}x\\t"
+        );
+        assert_eq!(escape_controls("Sign in to Ünïcode"), "Sign in to Ünïcode");
+    }
+}
