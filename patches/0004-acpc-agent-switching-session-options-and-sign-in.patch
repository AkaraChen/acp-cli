+    use codex_app_server_protocol::JSONRPCErrorError;
+    use color_eyre::eyre::WrapErr;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn missing_session_message_shows_the_bridge_error() {
+        let err = Err::<(), _>(TypedRequestError::Server {
+            method: "thread/read".to_string(),
+            source: JSONRPCErrorError {
+                code: -32600,
+                data: None,
+                message: "agent `mock` requires sign-in; run `acpc login -a mock`".to_string(),
+            },
+        })
+        .wrap_err("thread/read failed during TUI session lookup")
+        .unwrap_err();
+
+        assert_eq!(
+            missing_session_message("abc", "resume", Some(&err)),
+            "acpc could not open session abc: agent `mock` requires sign-in; run `acpc login -a mock`"
+        );
+        assert_eq!(
+            missing_session_message("abc", "resume", /*lookup_error*/ None),
+            "No saved session found with ID abc. Run `acpc resume` without an ID to choose from existing sessions."
+        );
+    }
+}
