+fn send(event: AcpcAppEvent) -> Box<dyn Fn(&crate::app_event_sender::AppEventSender) + Send + Sync> {
+    let event = std::sync::Mutex::new(Some(event));
+    Box::new(move |tx| {
+        if let Some(event) = event
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+        {
+            tx.send(AppEvent::Acpc(event));
+        }
+    })
+}
 
