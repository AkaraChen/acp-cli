+/// Why `acpc resume <id>` cannot open a session. The bridge's own message
+/// (sign-in needed, no agent has the session, ...) replaces Codex's.
+pub(crate) fn missing_session_message(
+    id: &str,
+    action: &str,
+    lookup_error: Option<&color_eyre::Report>,
+) -> String {
+    let Some(err) = lookup_error else {
+        return format!(
+            "No saved session found with ID {id}. Run `acpc {action}` without an ID to choose from existing sessions."
+        );
+    };
+    let reason = err
+        .chain()
+        .find_map(|cause| {
+            match cause.downcast_ref::<codex_app_server_client::TypedRequestError>()? {
+                codex_app_server_client::TypedRequestError::Server { source, .. } => {
+                    Some(source.message.clone())
+                }
+                other => Some(other.to_string()),
+            }
+        })
+        .unwrap_or_else(|| format!("{err:#}"));
+    format!("acpc could not open session {id}: {reason}")
+}
+
+/// App-level acpc actions, sent from pickers and server requests.
+#[derive(Debug)]
+pub(crate) enum AcpcAppEvent {
+    /// The user picked an agent in /agent; asks about the current
+    /// conversation first when there is one.
+    SelectAgent { slug: String },
+    /// Switch agents (`acpc/agent/select`), then start a new session, or
+    /// fork the current one onto the new agent to bring its conversation.
+    SwitchAgent { slug: String, bring: bool },
+    SetConfigOption {
+        config_id: String,
+        value: codex_app_server_protocol::AcpcSessionConfigInput,
+    },
+    SetMode { mode_id: String },
+    /// Show the values of one select option.
+    OpenOptionValues { config_id: String },
+    OpenModes,
+    /// The user picked (or dismissed) a sign-in method.
+    AuthChosen { key: u64, method_id: Option<String> },
+    /// Run an interactive command with the terminal (`acpc/terminal/run`).
+    RunTerminal {
+        params: codex_app_server_protocol::AcpcTerminalRunParams,
+        reply: codex_app_server_client::AppServerReplyHandle,
+    },
+    Error(String),
+}
+
+static NEXT_REPLY_KEY: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+
+fn pending_replies() -> std::sync::MutexGuard<
+    'static,
+    std::collections::HashMap<u64, codex_app_server_client::AppServerReplyHandle>,
+> {
+    static REPLIES: std::sync::OnceLock<
+        std::sync::Mutex<
+            std::collections::HashMap<u64, codex_app_server_client::AppServerReplyHandle>,
+        >,
+    > = std::sync::OnceLock::new();
+    REPLIES
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+/// Keep a server-request reply until a picker answers it.
+pub(crate) fn store_reply(reply: codex_app_server_client::AppServerReplyHandle) -> u64 {
+    let key = NEXT_REPLY_KEY.fetch_add(1, Ordering::Relaxed);
+    pending_replies().insert(key, reply);
+    key
+}
+
+pub(crate) fn take_reply(key: u64) -> Option<codex_app_server_client::AppServerReplyHandle> {
+    pending_replies().remove(&key)
+}
