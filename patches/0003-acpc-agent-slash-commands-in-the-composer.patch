+
+    #[test]
+    fn acpc_mode_lists_agent_commands_and_hides_codex_builtins() {
+        let _acpc = crate::acpc::enable_for_test();
+        let agent = |name: &str| crate::acpc::AgentSlashCommand {
+            name: name.to_string(),
+            description: format!("agent {name}"),
+            input_hint: None,
+        };
+        let popup = CommandPopup::new(CommandPopupFlags::default(), Vec::new())
+            .with_agent_commands(&[agent("init"), agent("model"), agent("review")]);
+        let items = popup.filtered_items();
+        let names: Vec<&str> = items.iter().map(CommandItem::command).collect();
+        assert!(items.contains(&CommandItem::Agent(agent("init"))));
+        assert!(items.contains(&CommandItem::Agent(agent("review"))));
+        // Reserved lifecycle commands stay built-in even when the agent has one.
+        assert!(items.contains(&CommandItem::Builtin(SlashCommand::Model)));
+        assert_eq!(names.iter().filter(|name| **name == "model").count(), 1);
+        assert!(names.contains(&"new"));
+        // Codex-only built-ins are gone.
+        assert!(!items.contains(&CommandItem::Builtin(SlashCommand::Permissions)));
+        assert!(!items.contains(&CommandItem::Builtin(SlashCommand::Feedback)));
+        assert!(!items.contains(&CommandItem::Builtin(SlashCommand::Init)));
+    }
 }
