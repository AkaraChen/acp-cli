 }
+
+/// A slash command the agent advertised; running it sends `/name args` as
+/// ordinary prompt text (ACP `available_commands_update`).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct AgentSlashCommand {
+    pub(crate) name: String,
+    pub(crate) description: String,
+    pub(crate) input_hint: Option<String>,
+}
+
+impl From<&codex_app_server_protocol::AcpcAvailableCommand> for AgentSlashCommand {
+    fn from(command: &codex_app_server_protocol::AcpcAvailableCommand) -> Self {
+        Self {
+            name: command.name.clone(),
+            description: command.description.clone(),
+            input_hint: command.input_hint.clone(),
+        }
+    }
+}
+
+/// Built-ins that keep working against an ACP agent. The rest depend on
+/// Codex's own runtime, accounts or services.
+pub(crate) fn builtin_allowed(command: crate::slash_command::SlashCommand) -> bool {
+    use crate::slash_command::SlashCommand;
+    matches!(
+        command,
+        SlashCommand::Model
+            | SlashCommand::Keymap
+            | SlashCommand::Vim
+            | SlashCommand::New
+            | SlashCommand::Resume
+            | SlashCommand::Copy
+            | SlashCommand::Export
+            | SlashCommand::Raw
+            | SlashCommand::Tui
+            | SlashCommand::Mention
+            | SlashCommand::Status
+            | SlashCommand::Warnings
+            | SlashCommand::Pwd
+            | SlashCommand::Title
+            | SlashCommand::Statusline
+            | SlashCommand::Theme
+            | SlashCommand::Quit
+            | SlashCommand::Exit
+            | SlashCommand::Clear
+    )
+}
+
+/// Session lifecycle commands an agent command cannot replace.
+const RESERVED_COMMANDS: &[&str] = &[
+    "quit", "exit", "new", "resume", "clear", "model", "agent", "options",
+];
+
+/// Agent commands named like a reserved built-in are not offered.
+pub(crate) fn is_reserved(name: &str) -> bool {
+    RESERVED_COMMANDS.contains(&name)
+}
+
+/// Whether `name` runs the agent's command instead of a built-in.
+pub(crate) fn agent_shadows<'a>(
+    name: &str,
+    mut agent_commands: impl Iterator<Item = &'a str>,
+) -> bool {
+    enabled() && !is_reserved(name) && agent_commands.any(|command| command == name)
+}
