+/// Enables acpc mode on the current test thread until dropped. Test threads
+/// are reused, so the guard must outlive every assertion that needs it.
+#[cfg(test)]
+pub(crate) struct TestModeGuard(());
+
+#[cfg(test)]
+impl Drop for TestModeGuard {
+    fn drop(&mut self) {
+        TEST_ENABLED.with(|enabled| enabled.set(false));
+    }
+}
+
 /// Tests run in parallel; enable acpc mode for the current thread only.
 #[cfg(test)]
-pub(crate) fn enable_for_test() {
+pub(crate) fn enable_for_test() -> TestModeGuard {
     TEST_ENABLED.with(|enabled| enabled.set(true));
+    TestModeGuard(())
 }
 
