+++ b/codex-rs/app-server-protocol/schema/json/v2/AcpcNoticeNotification.json
@@ -0,0 +1,32 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "description": "A user-facing notice from the agent (ACP `notice` session update).",
+  "properties": {
+    "description": {
+      "default": null,
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "severity": {
+      "description": "`info`, `warning`, `error`, or another value the agent chose.",
+      "type": "string"
+    },
+    "threadId": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "title": {
+      "type": "string"
+    }
+  },
+  "required": [
+    "severity",
+    "title"
+  ],
+  "title": "AcpcNoticeNotification",
+  "type": "object"
+}
\ No newline at end of file
diff --git a/codex-rs/app-server-protocol/schema/json/v2/AcpcSessionConfigUpdatedNotification.json b/codex-rs/app-server-protocol/schema/json/v2/AcpcSessionConfigUpdatedNotification.json
new file mode 100644
index 0000000..af31787
--- /dev/null
+++ b/codex-rs/app-server-protocol/schema/json/v2/AcpcSessionConfigUpdatedNotification.json
@@ -0,0 +1,190 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "definitions": {
+    "AcpcSessionConfigKind": {
+      "oneOf": [
+        {
+          "properties": {
+            "currentValue": {
+              "type": "string"
+            },
+            "options": {
+              "items": {
+                "$ref": "#/definitions/AcpcSessionConfigValue"
+              },
+              "type": "array"
+            },
+            "type": {
+              "enum": [
+                "select"
+              ],
+              "title": "SelectAcpcSessionConfigKindType",
+              "type": "string"
+            }
+          },
+          "required": [
+            "currentValue",
+            "options",
+            "type"
+          ],
+          "title": "SelectAcpcSessionConfigKind",
+          "type": "object"
+        },
+        {
+          "properties": {
+            "currentValue": {
+              "type": "boolean"
+            },
+            "type": {
+              "enum": [
+                "boolean"
+              ],
+              "title": "BooleanAcpcSessionConfigKindType",
+              "type": "string"
+            }
+          },
+          "required": [
+            "currentValue",
+            "type"
+          ],
+          "title": "BooleanAcpcSessionConfigKind",
+          "type": "object"
+        }
+      ]
+    },
+    "AcpcSessionConfigOption": {
+      "description": "An ACP session config option, in the agent's order.",
+      "properties": {
+        "category": {
+          "default": null,
+          "description": "ACP category (`mode`, `model`, `model_config`, `thought_level`, …).",
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "description": {
+          "default": null,
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "id": {
+          "type": "string"
+        },
+        "kind": {
+          "$ref": "#/definitions/AcpcSessionConfigKind"
+        },
+        "name": {
+          "type": "string"
+        }
+      },
+      "required": [
+        "id",
+        "kind",
+        "name"
+      ],
+      "type": "object"
+    },
+    "AcpcSessionConfigValue": {
+      "properties": {
+        "description": {
+          "default": null,
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "group": {
+          "default": null,
+          "description": "Display group for grouped select options.",
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "name": {
+          "type": "string"
+        },
+        "value": {
+          "type": "string"
+        }
+      },
+      "required": [
+        "name",
+        "value"
+      ],
+      "type": "object"
+    },
+    "AcpcSessionMode": {
+      "properties": {
+        "description": {
+          "default": null,
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "id": {
+          "type": "string"
+        },
+        "name": {
+          "type": "string"
+        }
+      },
+      "required": [
+        "id",
+        "name"
+      ],
+      "type": "object"
+    },
+    "AcpcSessionModes": {
+      "description": "Legacy ACP session modes, sent only when the agent has no config options.",
+      "properties": {
+        "available": {
+          "items": {
+            "$ref": "#/definitions/AcpcSessionMode"
+          },
+          "type": "array"
+        },
+        "currentModeId": {
+          "type": "string"
+        }
+      },
+      "required": [
+        "available",
+        "currentModeId"
+      ],
+      "type": "object"
+    }
+  },
+  "properties": {
+    "modes": {
+      "anyOf": [
+        {
+          "$ref": "#/definitions/AcpcSessionModes"
+        },
+        {
+          "type": "null"
+        }
+      ],
+      "default": null
+    },
+    "options": {
+      "items": {
+        "$ref": "#/definitions/AcpcSessionConfigOption"
+      },
+      "type": "array"
+    },
+    "threadId": {
+      "type": "string"
+    }
+  },
+  "required": [
+    "options",
+    "threadId"
+  ],
+  "title": "AcpcSessionConfigUpdatedNotification",
+  "type": "object"
+}
\ No newline at end of file
