 pub(super) fn server_request_thread_id(request: &ServerRequest) -> Option<ThreadId> {
     match request {
+        // acpc requests are app-scoped; see `app/acpc.rs`.
+        ServerRequest::AcpcAuthSelect { .. } | ServerRequest::AcpcTerminalRun { .. } => None,
         ServerRequest::CommandExecutionRequestApproval { params, .. } => {
             ThreadId::from_string(&params.thread_id).ok()
         }
@@ -46,6 +48,17 @@ pub(super) fn server_notification_thread_target(
     notification: &ServerNotification,
 ) -> ServerNotificationThreadTarget {
     let thread_id = match notification {
+        ServerNotification::AcpcAvailableCommandsUpdated(notification) => {
+            Some(notification.thread_id.as_str())
+        }
+        ServerNotification::AcpcSessionConfigUpdated(notification) => {
+            Some(notification.thread_id.as_str())
+        }
+        ServerNotification::AcpcNotice(notification) => match notification.thread_id.as_deref() {
+            Some(thread_id) => Some(thread_id),
+            None => return ServerNotificationThreadTarget::AppScoped,
+        },
+        ServerNotification::AcpcAgentsUpdated(_) => None,
         ServerNotification::Error(notification) => Some(notification.thread_id.as_str()),
         ServerNotification::ThreadStarted(notification) => Some(notification.thread.id.as_str()),
         ServerNotification::ThreadStatusChanged(notification) => {
