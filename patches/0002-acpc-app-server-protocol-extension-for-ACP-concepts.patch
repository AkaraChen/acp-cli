+++ b/codex-rs/tui/src/chatwidget/acpc.rs
@@ -0,0 +1,43 @@
+//! acpc: chat widget handling of the `acpc/*` notifications.
+
+use codex_app_server_protocol::ServerNotification;
+
+use super::ChatWidget;
+use super::ReplayKind;
+
+impl ChatWidget {
+    pub(super) fn on_acpc_notification(
+        &mut self,
+        notification: ServerNotification,
+        replay_kind: Option<ReplayKind>,
+    ) {
+        match notification {
+            ServerNotification::AcpcAvailableCommandsUpdated(notification) => {
+                self.acpc.commands = notification.commands;
+            }
+            ServerNotification::AcpcSessionConfigUpdated(notification) => {
+                self.acpc.options = notification.options;
+                self.acpc.modes = notification.modes;
+            }
+            ServerNotification::AcpcAgentsUpdated(notification) => {
+                self.acpc.agents = notification.agents;
+                self.acpc.current_agent = Some(notification.current);
+            }
+            ServerNotification::AcpcNotice(notice) => {
+                if replay_kind.is_some() {
+                    return;
+                }
+                let message = match notice.description {
+                    Some(description) => format!("{}: {description}", notice.title),
+                    None => notice.title,
+                };
+                match notice.severity.as_str() {
+                    "error" => self.add_error_message(message),
+                    "warning" => self.add_warning_message(message),
+                    _ => self.add_info_message(message, /*hint*/ None),
+                }
+            }
+            _ => {}
+        }
+    }
+}
