+//! acpc: running the TUI as the front end of an ACP client.
+//!
+//! acpc (https://agentclientprotocol.com clients) drives this TUI through an
+//! app-server bridge to ACP agents. Everything acpc changes in the TUI is
+//! gated on [`enabled`], so stock Codex behaviour is untouched.
+
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+/// Turn on acpc behaviour for this process. Call before `run_main`.
+pub fn enable() {
+    ENABLED.store(true, Ordering::Relaxed);
+}
+
+#[cfg(not(test))]
+pub(crate) fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+#[cfg(test)]
+thread_local! {
+    static TEST_ENABLED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Tests run in parallel; enable acpc mode for the current thread only.
+#[cfg(test)]
+pub(crate) fn enable_for_test() {
+    TEST_ENABLED.with(|enabled| enabled.set(true));
+}
+
+#[cfg(test)]
+pub(crate) fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed) || TEST_ENABLED.with(std::cell::Cell::get)
+}
+
+/// ACP state mirrored from the bridge for the current session.
+#[derive(Debug, Default)]
+pub(crate) struct AcpcChatState {
+    pub(crate) agents: Vec<codex_app_server_protocol::AcpcAgent>,
+    pub(crate) current_agent: Option<String>,
+    pub(crate) commands: Vec<codex_app_server_protocol::AcpcAvailableCommand>,
+    pub(crate) options: Vec<codex_app_server_protocol::AcpcSessionConfigOption>,
+    pub(crate) modes: Option<codex_app_server_protocol::AcpcSessionModes>,
+}
