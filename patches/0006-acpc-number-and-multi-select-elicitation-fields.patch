+//! acpc: number and multi-select elicitation fields. ACP agents request
+//! these through `elicitation/create`; without them the whole form would
+//! fall back to a bare accept/decline prompt.
+
+use codex_app_server_protocol::McpElicitationMultiSelectEnumSchema;
+use codex_app_server_protocol::McpElicitationNumberSchema;
+use codex_app_server_protocol::McpElicitationNumberType;
+use serde_json::Value;
+
+use super::McpServerElicitationField;
+use super::McpServerElicitationFieldInput;
+use super::McpServerElicitationOption;
+
+pub(super) fn number_field(
+    id: &str,
+    schema: McpElicitationNumberSchema,
+    required: bool,
+) -> McpServerElicitationField {
+    let label = schema.title.unwrap_or_else(|| id.to_string());
+    let prompt = schema.description.unwrap_or_else(|| label.clone());
+    McpServerElicitationField {
+        id: id.to_string(),
+        label,
+        prompt,
+        required,
+        input: McpServerElicitationFieldInput::Number {
+            integer: schema.type_ == McpElicitationNumberType::Integer,
+            minimum: schema.minimum,
+            maximum: schema.maximum,
+        },
+    }
+}
+
+pub(super) fn multi_select_field(
+    id: &str,
+    schema: McpElicitationMultiSelectEnumSchema,
+    required: bool,
+) -> McpServerElicitationField {
+    let (title, description, min_items, max_items, default, options) = match schema {
+        McpElicitationMultiSelectEnumSchema::Untitled(schema) => (
+            schema.title,
+            schema.description,
+            schema.min_items,
+            schema.max_items,
+            schema.default,
+            schema
+                .items
+                .enum_
+                .into_iter()
+                .map(|value| McpServerElicitationOption {
+                    label: value.clone(),
+                    description: None,
+                    value: Value::String(value),
+                })
+                .collect::<Vec<_>>(),
+        ),
+        McpElicitationMultiSelectEnumSchema::Titled(schema) => (
+            schema.title,
+            schema.description,
+            schema.min_items,
+            schema.max_items,
+            schema.default,
+            schema
+                .items
+                .any_of
+                .into_iter()
+                .map(|option| McpServerElicitationOption {
+                    label: option.title,
+                    description: None,
+                    value: Value::String(option.const_),
+                })
+                .collect::<Vec<_>>(),
+        ),
+    };
+    let label = title.unwrap_or_else(|| id.to_string());
+    let prompt = description.unwrap_or_else(|| label.clone());
+    let default_checked = default
+        .unwrap_or_default()
+        .into_iter()
+        .filter_map(|value| {
+            options
+                .iter()
+                .position(|option| option.value == Value::String(value.clone()))
+        })
+        .collect();
+    McpServerElicitationField {
+        id: id.to_string(),
+        label,
+        prompt,
+        required,
+        input: McpServerElicitationFieldInput::MultiSelect {
+            options,
+            min_items,
+            max_items,
+            default_checked,
+        },
+    }
+}
+
+/// Parse a typed number, or explain what is wrong with it.
+pub(super) fn parse_number(
+    text: &str,
+    integer: bool,
+    minimum: Option<f64>,
+    maximum: Option<f64>,
+) -> Result<Value, String> {
+    let text = text.trim();
+    let value = if integer {
+        let number = text
+            .parse::<i64>()
+            .map_err(|_| "Enter a whole number.".to_string())?;
+        // Bounds are compared as f64, like the schema states them.
+        #[allow(clippy::cast_precision_loss)]
+        let as_float = number as f64;
+        check_bounds(as_float, minimum, maximum)?;
+        Value::from(number)
+    } else {
+        let number = text
+            .parse::<f64>()
+            .ok()
+            .filter(|number| number.is_finite())
+            .ok_or_else(|| "Enter a number.".to_string())?;
+        check_bounds(number, minimum, maximum)?;
+        Value::from(number)
+    };
+    Ok(value)
+}
+
+fn check_bounds(value: f64, minimum: Option<f64>, maximum: Option<f64>) -> Result<(), String> {
+    match (minimum, maximum) {
+        (Some(min), Some(max)) if value < min || value > max => {
+            Err(format!("Enter a number from {min} to {max}."))
+        }
+        (Some(min), _) if value < min => Err(format!("Enter a number of at least {min}.")),
+        (_, Some(max)) if value > max => Err(format!("Enter a number of at most {max}.")),
+        _ => Ok(()),
+    }
+}
+
+/// Check a multi-select answer's size against the schema.
+pub(super) fn check_item_count(
+    count: usize,
+    min_items: Option<u64>,
+    max_items: Option<u64>,
+) -> Result<(), String> {
+    let count = u64::try_from(count).unwrap_or(u64::MAX);
+    if let Some(min) = min_items
+        && count < min
+    {
+        return Err(format!("Choose at least {min}."));
+    }
+    if let Some(max) = max_items
+        && count > max
+    {
+        return Err(format!("Choose at most {max}."));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn numbers_are_parsed_and_bounded() {
+        assert_eq!(parse_number(" 42 ", true, None, None), Ok(Value::from(42)));
+        assert_eq!(
+            parse_number("4.5", true, None, None),
+            Err("Enter a whole number.".to_string())
+        );
+        assert_eq!(parse_number("4.5", false, Some(1.0), Some(5.0)), Ok(Value::from(4.5)));
+        assert_eq!(
+            parse_number("9", false, Some(1.0), Some(5.0)),
+            Err("Enter a number from 1 to 5.".to_string())
+        );
+        assert_eq!(
+            parse_number("abc", false, None, None),
+            Err("Enter a number.".to_string())
+        );
+    }
+
+    #[test]
+    fn item_counts_are_bounded() {
+        assert_eq!(check_item_count(1, Some(1), Some(2)), Ok(()));
+        assert_eq!(check_item_count(0, Some(1), None), Err("Choose at least 1.".to_string()));
+        assert_eq!(check_item_count(3, None, Some(2)), Err("Choose at most 2.".to_string()));
+    }
+}
